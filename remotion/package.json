{
  "name": "tradework-tracker-remotion",
  "version": "1.0.0",
  "description": "Remotion promo video project for TradeWork Tracker",
  "private": true,
  "scripts": {
    "dev": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts PromoVideo out/promo.mp4",
    "render:gif": "remotion render src/index.ts PromoVideo out/promo.gif --codec gif",
    "render:still": "remotion still src/index.ts PromoVideo --frame=60 out/still.png",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.3"
  },
  "remotion": {
    "entryPoint": "src/index.ts"
  }
}
